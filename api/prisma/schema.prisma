// SQLite for local development — no Azure DB needed.
// When you're ready to deploy, change provider to "postgresql"
// and update DATABASE_URL to your Azure PostgreSQL connection string.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Account auth (email/password) — replaces the earlier Azure Static Web
// Apps AAD-only login. passwordHash is a bcrypt hash, never the raw
// password. Projects aren't scoped to a user yet (every signed-in user
// currently sees every project, same as before this model existed) — this
// only gates the app behind real accounts; per-user data isolation would be
// a separate follow-up.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  // "professor" (default — the existing client role, unchanged behavior) |
  // "admin" (new — gates /admin routes and endpoints). Plain string, not a
  // Prisma enum, to match every other status/role-shaped field in this
  // schema (Project.status, Scene.status, etc.) — SQLite has no native enum
  // type anyway, Prisma would just emulate one.
  role         String   @default("professor")
  // Email verification (2026-08-15) — signup no longer logs a user in
  // immediately; a 6-digit code is emailed and the account stays gated
  // (login blocked) until it's entered — see auth/signup.ts, auth/verify.ts,
  // auth/resendCode.ts. The code itself is bcrypt-hashed, same as
  // passwordHash, so a raw DB read alone can't be replayed to verify as
  // someone else. verificationAttempts caps guesses per code (see
  // MAX_VERIFY_ATTEMPTS in auth/verify.ts); verificationSentAt rate-limits
  // resends (see RESEND_COOLDOWN_SEC in auth/resendCode.ts).
  //
  // Schema default is TRUE, not false — this column is being added to a
  // table that already has real accounts (including whoever is running this
  // app right now) with no verification code ever sent to them. A `false`
  // default would retroactively lock every existing account out the moment
  // login starts checking this flag. New signups explicitly override this to
  // `false` at creation time instead (see auth/signup.ts) — only brand-new
  // accounts go through the gate.
  emailVerified           Boolean   @default(true) @map("email_verified")
  verificationCodeHash    String?   @map("verification_code_hash")
  verificationCodeExpires DateTime? @map("verification_code_expires")
  verificationAttempts    Int       @default(0) @map("verification_attempts")
  verificationSentAt      DateTime? @map("verification_sent_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Project {
  id              String       @id @default(uuid())
  // Owning professor (2026-08-13 — "user history should be different": every
  // signed-in user was seeing every project, not just their own). Nullable
  // and NOT a hard Prisma @relation on purpose: (1) existing rows predate
  // this column and have no owner to backfill to — they stay userId=null,
  // meaning they're only visible via the unfiltered /api/admin/projects
  // console, not any professor's personal dashboard, until reassigned; (2) a
  // real FK would reject writes from the LOCAL_DEV mock user (api/src/lib/
  // auth.ts's DEV_USER.userId is a fixed placeholder string with no actual
  // User row behind it) — keeping this a plain column avoids that entirely.
  userId          String?      @map("user_id")
  title           String
  status          String       @default("draft")
  hiltGates       String?      @map("hilt_gates")   // JSON string in SQLite
  defaultAvatarId String?      @map("default_avatar_id")
  defaultVoiceId  String?      @map("default_voice_id")
  // Full HeyGen-style avatar studio settings (#37) — set on the dedicated
  // Avatar Studio stage, applied uniformly to every scene at video-render time.
  avatarStyle      String?     @default("normal") @map("avatar_style")       // "normal" | "circle" | "closeUp"
  avatarBackground String?     @map("avatar_background")                      // JSON string: {"type":"color","value":"#1E293B"}
  voiceSettings    String?     @map("voice_settings")                         // JSON string: {stability, similarity_boost, style, speed}
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  modules         Module[]
  scripts         Script[]
  sourceFiles     SourceFile[]

  @@map("projects")
}

model Module {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  objective     String?
  orderIndex    Int      @map("order_index")
  status        String   @default("proposed")
  fullVideoUrl  String?  @map("full_video_url") // all scene videos concatenated into one module video
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  scenes        Scene[]
  scripts       Script[]

  @@map("modules")
}

model Scene {
  id                String    @id @default(uuid())
  moduleId          String    @map("module_id")
  module            Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  orderIndex        Int       @map("order_index")
  // "welcome" (hook+objectives, #29) | "content" (default) | "quiz" (#31).
  // Drives which prompt template generated this scene and how the frontend/
  // renderer should treat it — see scriptGeneratorAgent.ts.
  sceneKind         String    @default("content") @map("scene_kind")
  scriptContent     String?   @map("script_content")
  slideDeckContent  String?   @map("slide_deck_content")  // JSON string — legacy/aggregate single-slide view, kept for back-compat with panels that haven't moved to segments yet
  visualPrompt      String?   @map("visual_prompt")
  visualAssetUrl    String?   @map("visual_asset_url")
  textAnimationType String    @default("none") @map("text_animation_type")
  textCues          String?   @map("text_cues")            // JSON string
  // JSON string of QuizQuestion[] — only populated when sceneKind === "quiz" (#31).
  quizData          String?   @map("quiz_data")
  presenterPosition String    @default("bottom-right") @map("presenter_position")
  avatarPositionX   Float?    @map("avatar_position_x")
  avatarPositionY   Float?    @map("avatar_position_y")
  ttsAudioUrl       String?   @map("tts_audio_url")
  avatarVideoUrl    String?   @map("avatar_video_url")
  // Which HeyGen engine last rendered this scene's avatar clip — "avatar_iii"
  // (cheap, the normal path) or "avatar_iv" (2-4x costlier fallback, see
  // heygenAvatar.ts createAvatarVideo()). Persisted (previously this only
  // lived transiently in the pending-job sidecar and got deleted once the
  // job finished) so the admin dashboard can actually report real per-engine
  // usage instead of a fake number.
  avatarEngineUsed  String?   @map("avatar_engine_used")
  status            String    @default("draft")
  durationSeconds   Float?    @map("duration_seconds")
  approvedAt        DateTime? @map("approved_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  segments          SceneSegment[]
  // One composition PER SEGMENT now (#40 — per-part slides in Visual
  // Design), not one per scene — see SlideComposition below. Kept as a
  // plain one-to-many (not @unique on the FK) so a multi-segment scene
  // (e.g. a 4-part welcome scene) can have up to one composition per
  // segment simultaneously.
  compositions      SlideComposition[]

  @@map("scenes")
}

/// A scene is rendered from one or more ordered sub-slide segments — each
/// with its own narration text (one ElevenLabs TTS call each, per #29) and
/// its own slide elements/animation hints. A simple content scene has exactly
/// one segment (segmentType "content"); the welcome scene (#29) has five
/// (hook/content/content/interaction/recap); the quiz scene (#31) has one
/// "question" segment per question. The render pipeline renders each segment
/// to its own image+audio clip, then concatenates them into the scene's
/// single avatarVideoUrl — see api/src/lib/ffmpegVideo.ts.
model SceneSegment {
  id              String    @id @default(uuid())
  sceneId         String    @map("scene_id")
  scene           Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  orderIndex      Int       @map("order_index")
  // "hook" | "content" | "interaction" | "recap" | "question" | "answer"
  segmentType     String    @map("segment_type")
  text            String    // narration script for this segment's own TTS call
  slideTitle      String?   @map("slide_title")
  elements        String    @default("[]") // JSON string of SlideElement[]
  // Full Visual Designer slide design for THIS segment alone (#38) — same
  // shape as Scene.slideDeckContent (title/subtitle/layout/theme/blocks),
  // so each segment (hook/content/content/interaction/recap) can have its
  // own independent slide instead of sharing the whole scene's one design.
  // "{}" (empty) means this segment hasn't been individually designed yet —
  // the render pipeline falls back to the old simple per-segment slide in
  // that case. See api/src/lib/slideRenderer.ts + ffmpegVideo.ts.
  slideDesign     String    @default("{}") @map("slide_design")
  imagePrompt     String?   @map("image_prompt")
  animation       String?   // top-level entrance animation for this segment, e.g. "fade-in"
  // Text animation timings for custom reveals — JSON array of timing objects
  // [{ "elementIndex": 0, "startMs": 100, "durationMs": 800 }, ...]
  textAnimationTimings String? @map("text_animation_timings")
  ttsAudioUrl     String?   @map("tts_audio_url")
  durationSeconds Float?    @map("duration_seconds")
  // Generated slide preview image for THIS segment alone (#40 — per-part
  // slides in Visual Design). Mirrors Scene.visualAssetUrl but scoped to one
  // segment, so a 4-part welcome scene can show/generate 4 independent
  // thumbnails instead of all four sharing the scene's single slot. The
  // primary segment (orderIndex 0) still also mirrors into
  // Scene.visualAssetUrl for back-compat with the HeyGen/avatar-video
  // pipeline (generateHyperFramesSlide.ts, pollHeyGenVideo.ts), which reads
  // only the scene-level field.
  visualAssetUrl  String?   @map("visual_asset_url")
  // This segment's OWN individually-rendered avatar clip (slide + talking
  // avatar composited together for just this one part) — set once this
  // segment has been generated on its own via Final Video's per-segment
  // tiles or Visual Designer's per-row render. Once every sibling segment
  // of the parent scene also has this set, heygenFinalize.ts's
  // stitchSceneFromSegments() concatenates them in orderIndex order into
  // the scene's real Scene.avatarVideoUrl automatically. Replaces the old
  // behavior where a per-segment render was a throwaway preview that never
  // persisted anywhere.
  avatarVideoUrl  String?   @map("avatar_video_url")
  composition     SlideComposition?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("scene_segments")
}

model Script {
  id                       String   @id @default(uuid())
  projectId                String   @map("project_id")
  project                  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId                 String?  @map("module_id")
  module                   Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  title                    String
  version                  Int      @default(1)
  learningObjectives       String   @default("[]") @map("learning_objectives") // JSON string
  sections                 String   @default("[]")                             // JSON string
  status                   String   @default("review")
  estimatedDurationMinutes Float    @default(4.0) @map("estimated_duration_minutes")
  // Phase 1 HITL: Script lock mechanism
  approvalStatus           String   @default("draft") @map("approval_status") // 'draft' | 'approved' | 'locked'
  locked                   Boolean  @default(false)
  lockedAt                 DateTime? @map("locked_at")
  lockedBy                 String?  @map("locked_by") // user_id
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("scripts")
}

model SourceFile {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName  String   @map("file_name")
  fileType  String   @map("file_type")
  fileUrl   String   @map("file_url")
  fileSize      Int?     @map("file_size")
  extractedText String?  @map("extracted_text")  // text extracted from PDF/TXT at upload time
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("source_files")
}

/// WYSIWYG Canvas Composition — Visual Designer slide data.
/// Single source of truth for the Visual Designer canvas — one row PER
/// SEGMENT (#40), not per scene, so a multi-part scene (e.g. a 4-part
/// welcome scene: hook/content/content/recap) gets 4 independently editable
/// slides instead of sharing one. On every save this is also synced into
/// ITS OWN SceneSegment.slideDesign (see compositions.ts#syncCompositionToSegment)
/// so the actual render pipeline
/// (slideRenderer.ts + ffmpegVideo.ts) always matches what's shown here.
model SlideComposition {
  id              String   @id @default(uuid())
  // scene_id is kept (non-unique) for convenient "all slides in this scene"
  // queries (e.g. getModuleCompositions) — the real 1:1 key is segment_id
  // below. Before #40, this was `@unique`, meaning only ONE composition
  // could exist per scene at all — that's the exact bug that made a 4-part
  // welcome scene (hook/content/content/recap) show only its first part as
  // an editable slide in Visual Design, while Script Generation/Voice
  // already treated all 4 as separate narrated parts.
  sceneId         String   @map("scene_id")
  scene           Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  // The true 1:1 key (#40) — one composition per SceneSegment, so each
  // narrated part of a scene gets its own independently editable slide.
  segmentId       String   @unique @map("segment_id")
  segment         SceneSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  // Template & Styling — maps 1:1 to a slideRenderer.ts THEMES key
  templateId      String   @default("modern") @map("template_id")

  // Slide Layout — maps 1:1 to a slideRenderer.ts buildSlide() layout switch
  // case ('title-hero' | 'bullets' | 'split' | 'definition' | 'quote' |
  // 'summary'). NOT the same for every slide by default: the seed logic in
  // compositions.ts picks a sensible default per scene (e.g. the module's
  // intro/welcome scene defaults to 'title-hero' — title centered in the
  // middle — while ordinary content scenes default to 'bullets'). The user
  // can override per-slide via the layout picker.
  layout          String   @default("bullets")
  
  // Frame/Cadre Style for Content Points — visual effect around content blocks
  // 'none' | 'subtle' | 'bold' | 'rounded'
  cadreStyle      String   @default("none") @map("cadre_style")
  
  // Text Content — no forced bullet format (#7). JSON array of
  // { text: string, keyPoints: string[] }: each entry is one focused main
  // idea with its own nested supporting points underneath. Unlimited count —
  // the layout engine scales font/spacing to fit however many the content
  // actually needs instead of capping at a fixed number.
  title           String   @default("Untitled Slide")
  // Key Insight — the single sentence students should remember, shown right
  // under the title (matches slideRenderer.ts's `subtitle` field).
  subtitle        String   @default("")
  contentBlocks   String   @default("[]") @map("content_blocks")

  // Independent drag offsets (% of slide) for title, key insight, and the
  // content/bullets block — each one drops SEPARATELY, not as one glued
  // unit, matching slideRenderer.ts's buildSlide() which already positions
  // title/subtitle/content as three distinct elements via positions.title /
  // positions.subtitle / positions.content. (0,0 = default layout position,
  // unmoved.)
  titleX          Float    @default(0) @map("title_x")
  titleY          Float    @default(0) @map("title_y")
  subtitleX       Float    @default(0) @map("subtitle_x")
  subtitleY       Float    @default(0) @map("subtitle_y")
  contentX        Float    @default(0) @map("content_x")
  contentY        Float    @default(0) @map("content_y")

  // User-adjustable font-size multiplier (1 = default size) for each text
  // element, independent of the auto-fit shrink the canvas already does to
  // avoid overflow — this is a deliberate user choice ("make the title
  // bigger/smaller"), not a responsive fallback.
  titleFontScale    Float  @default(1) @map("title_font_scale")
  subtitleFontScale Float  @default(1) @map("subtitle_font_scale")
  contentFontScale  Float  @default(1) @map("content_font_scale")
  
  // Avatar Placeholder Position & Size (% of slide, center-anchored, 9:16)
  avatarX         Float    @default(75) @map("avatar_x")
  avatarY         Float    @default(50) @map("avatar_y")
  avatarWidth     Float    @default(20) @map("avatar_width")
  
  // Element Timeline Fields — Voice-sync timing for visual elements
  titleStartTime    Float   @default(0) @map("title_start_time")
  titleDuration     Float   @default(2) @map("title_duration")
  subtitleStartTime Float   @default(1) @map("subtitle_start_time")
  subtitleDuration  Float   @default(2.5) @map("subtitle_duration")
  // JSON array of { elementId, startTime, duration } for content blocks
  contentBlockTimings String  @default("[]") @map("content_block_timings")
  
  // Image Asset — freely resizable/repositionable independent of aspect
  // ratio (#5); imageWidth/imageHeight are both user-controlled so images
  // can be stretched, not just uniformly scaled.
  imageUrl        String?  @map("image_url")
  imageX          Float    @default(10) @map("image_x")
  imageY          Float    @default(70) @map("image_y")
  imageWidth      Float    @default(25) @map("image_width")
  imageHeight     Float    @default(25) @map("image_height")
  
  // Status
  status          String   @default("draft") // 'draft' | 'ready' | 'locked'

  // True once the user has actually saved an edit from the canvas (any PATCH).
  // While false, GET /scenes/{id}/composition keeps re-deriving title +
  // contentBlocks fresh from the scene's script/storyboard data on every
  // fetch — so slides always show what the pipeline generated (title, key
  // points, everything) and the user only ever edits, never starts blank.
  // Defaulting to false also means every composition row created by the
  // earlier (pre-autogeneration) version of this feature self-heals the
  // next time it's opened, instead of staying permanently blank.
  contentEdited   Boolean  @default(false) @map("content_edited")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([sceneId])
  @@map("slide_compositions")
}

/// Global app config the admin dashboard can view/edit (default avatar/voice,
/// feature flags, etc.) — a plain key/value store rather than one column per
/// setting, so the admin Settings page can add new toggles without another
/// migration each time. `value` is always a JSON string (SQLite has no
/// native JSON column, same convention as avatarBackground/voiceSettings
/// above).
model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
