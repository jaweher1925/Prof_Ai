
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
HEYGEN_API_KEY=...
ELEVENLABS_API_KEY=...

# Public HTTPS URL this API is reachable at once deployed (e.g. your Azure Web App URL).
# Enables HeyGen webhooks (push instead of poll) for avatar renders — see api/.env for
# the one-time POST /v3/webhooks/endpoints registration step this requires.
PUBLIC_BASE_URL=
# Signing secret returned by that registration call. Required for the webhook to be
# trusted — leave blank and the app keeps working via polling only.
HEYGEN_WEBHOOK_SECRET=
